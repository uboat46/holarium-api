##########################
# Application
##########################
NODE_ENV=development
PORT=3000

##########################
# Database (PostgreSQL)
##########################
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=holarium
DB_LOGGING=true
DB_SSL=false
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=5000

##########################
# JWT / Auth Secrets
##########################
# For development you can run `yarn generate:keys`
# to create the PEM files referenced below.
JWT_PRIVATE_KEY_PATH=keys/access-private.pem
JWT_PUBLIC_KEY_PATH=keys/access-public.pem
JWT_REFRESH_PRIVATE_KEY_PATH=keys/refresh-private.pem
JWT_REFRESH_PUBLIC_KEY_PATH=keys/refresh-public.pem
# Fallback secret when RSA keys are not provided (dev only)
JWT_SECRET=dev-jwt-secret-change-me
JWT_ISSUER=holarium-api
JWT_AUDIENCE=holarium-clients
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

##########################
# Password Hashing / Auth Behaviour
##########################
BCRYPT_ROUNDS=12
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_DURATION_MINUTES=15
MAX_REFRESH_TOKENS_PER_USER=5
TOKEN_REUSE_GRACE_PERIOD_SECONDS=0

##########################
# Rate Limiting / Throttling
##########################
THROTTLE_TTL=60
THROTTLE_LIMIT=60

##########################
# CORS
##########################
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type
CORS_EXPOSED_HEADERS=
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=600

##########################
# Misc
##########################
# Extend as needed for logging/email/etc.


