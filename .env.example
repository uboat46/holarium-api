##########################
# Application
##########################
NODE_ENV=development
PORT=3000

# Encryption key for device/IP data at rest (min 32 characters)
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=your-secure-encryption-key-min-32-chars

##########################
# Database (PostgreSQL)
##########################
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=holarium
DB_LOGGING=true
DB_SSL=false
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT=5000

##########################
# JWT / Auth Secrets
##########################
# RSA keys in PEM format (include the full key with newlines)
# For development: run `yarn generate:keys` then copy content
# For Docker: use multiline env vars or base64 encode
# Example: JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...rest of key...\n-----END PRIVATE KEY-----"
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_REFRESH_PRIVATE_KEY=
JWT_REFRESH_PUBLIC_KEY=
JWT_ISSUER=holarium-api
JWT_AUDIENCE=holarium-clients
ACCESS_TOKEN_TTL=5m
REFRESH_TOKEN_TTL=30d

##########################
# Password Hashing / Auth Behaviour
##########################
BCRYPT_ROUNDS=12
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_DURATION_MINUTES=15
MAX_REFRESH_TOKENS_PER_USER=5
TOKEN_REUSE_GRACE_PERIOD_SECONDS=0

##########################
# Global rate-limiting defaults (TTL in seconds, limit is request count)
##########################
THROTTLE_TTL=60
THROTTLE_LIMIT=60

##########################
# CORS
##########################
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type
CORS_EXPOSED_HEADERS=
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=600

##########################
# Misc
##########################
# Extend as needed for logging/email/etc.

